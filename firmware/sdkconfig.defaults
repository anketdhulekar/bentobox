# What every board shares. A board's flash and PSRAM settings are in boards/<board>/sdkconfig.board.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU and caches
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Code and fonts run from PSRAM, which is faster than the flash, and a flash write doesn't stop the caches.
# Internal RAM is kept for the display's DMA buffers and the Bluetooth controller.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y

# Logs and the debug interface go over the USB port (USB Serial/JTAG).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# No Wi-Fi and no TLS: mbedTLS is here only for PBKDF2 and the hashes under it.
CONFIG_MBEDTLS_TLS_DISABLED=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Bluetooth LE (NimBLE), peripheral only: one Mac at a time, up to four paired Macs kept in flash. Pairing is
# LE Secure Connections only, with the code on the screen. Host memory goes in PSRAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=48
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Bento"
